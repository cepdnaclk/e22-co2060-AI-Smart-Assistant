{
  "name": "ai-smart-assistant",
  "version": "1.0.0",
  "description": "AI Smart Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "SENTINELS",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sentinels.aismartassistant",
    "productName": "AI Smart Assistant",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "../code/dist/main",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
